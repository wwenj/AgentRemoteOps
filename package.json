{
  "name": "agent-remoteops",
  "version": "0.4.0",
  "description": "Temporary remote operations bridge for local coding agents",
  "type": "module",
  "bin": {
    "agent-remoteops": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwenj/AgentRemoteOps.git"
  },
  "homepage": "https://github.com/wwenj/AgentRemoteOps#readme",
  "bugs": {
    "url": "https://github.com/wwenj/AgentRemoteOps/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "prepare:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:skill": "python3 -m unittest discover -s skills/agent-remoteops/tests -p 'test_*.py'",
    "validate:skill": "python3 skills/agent-remoteops/tests/validate_skill.py",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm test:skill && pnpm validate:skill && pnpm build && npm pack --dry-run"
  },
  "keywords": [
    "agent",
    "remote-operations",
    "codex",
    "cloudflare-tunnel",
    "devops"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "commander": "^14.0.0",
    "fastify": "^5.5.0",
    "shell-quote": "^1.8.3",
    "zod": "^4.1.5"
  },
  "optionalDependencies": {
    "agent-remoteops-cloudflared-linux-arm64": "0.4.0",
    "agent-remoteops-cloudflared-linux-x64": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/shell-quote": "^1.7.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0"
}
